# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email (optional, https://resend.com). Without a key, emails are skipped and logged.
RESEND_API_KEY=
EMAIL_FROM=Dingalan Aurora <bookings@your-verified-domain.com>
BOOKING_NOTIFY_TO=dingalantravels@gmail.com
CONTACT_TO=dingalantravels@gmail.com
